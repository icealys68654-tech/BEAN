# TagEngine API
PORT=3000
NODE_ENV=development
ENTEC_API_TOKEN=replace-with-a-long-random-secret
ENTEC_SNAPSHOT_DIR=./data/snapshots

# Entec operations dashboard
TAGENGINE_URL=http://127.0.0.1:3000
TAGENGINE_API_TOKEN=replace-with-the-same-secret
ENTEC_DASHBOARD_HOST=127.0.0.1
ENTEC_DASHBOARD_PORT=4173
# Required if binding the Entec dashboard beyond loopback:
# ENTEC_DASHBOARD_TOKEN=replace-with-a-separate-dashboard-secret
