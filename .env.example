# TagEngine API and persistent storage
PORT=3000
NODE_ENV=production
ENTEC_API_TOKEN=replace-with-a-long-random-api-secret
ENTEC_SNAPSHOT_DIR=./data/snapshots
ENTEC_BACKUP_DIR=./backups

# Entec operations dashboard (the Docker deployment overrides host/port internally)
TAGENGINE_URL=http://127.0.0.1:3000
TAGENGINE_API_TOKEN=replace-with-the-same-value-as-ENTEC_API_TOKEN
ENTEC_DASHBOARD_HOST=127.0.0.1
ENTEC_DASHBOARD_PORT=4173
ENTEC_DASHBOARD_TOKEN=replace-with-a-separate-long-random-dashboard-secret

# Public HTTPS reverse proxy (DNS for both names must point to this host)
BEAN_DASHBOARD_DOMAIN=dashboard.example.com
BEAN_API_DOMAIN=api.example.com
BEAN_TLS_EMAIL=admin@example.com
ENTEC_PROXY_USER=bean-operator
ENTEC_PROXY_PASSWORD_HASH=replace-with-output-from-caddy-hash-password
